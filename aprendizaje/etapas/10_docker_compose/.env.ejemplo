# Copiar este archivo como .env (en esta misma carpeta) y cambiar los valores.
# Compose lee .env solo y reemplaza cada ${VARIABLE} de compose.yaml.
# .env NO se sube a git: el .gitignore del repositorio lo excluye.

DB_ROOT_PASSWORD=cambiar-por-una-clave-de-root
DB_USER=pl
DB_PASSWORD=cambiar-por-una-clave-de-la-base

# Generar con:  python -c "import secrets; print(secrets.token_hex(32))"
CLAVE_SECRETA=cambiar-por-64-caracteres-hexadecimales
