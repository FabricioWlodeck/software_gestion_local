# Copiar a .env y completar. .env nunca se sube al repositorio.
# Para generar valores aleatorios:  python -c "import secrets; print(secrets.token_urlsafe(24))"

# Base de datos
MARIADB_ROOT_PASSWORD=cambiar
MARIADB_DB=punto_lacteo
MARIADB_USER=puntolacteo
MARIADB_USER_PASS=cambiar
MARIADB_SERVER=mariadb

# Usuario de solo lectura del bot
TB_DB_USER=telegrambot
TB_DB_PASS=cambiar

# Token del bot (lo da @BotFather con /newbot). Vacío: el bot queda inactivo.
TB_TOKEN=

# Firma de los tokens de sesión:  python -c "import secrets; print(secrets.token_hex(32))"
CLAVE_SECRETA=cambiar

# Datos iniciales
DUENIA_USUARIO=duenia
DUENIA_NOMBRE=Dueña
DUENIA_CONTRASENA=cambiar
SEMILLA_CONTRASENA_EMPLEADOS=cambiar
